---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readQuestionLog, getTopQuestions, getUnansweredQuestions } from '../../lib/stats';

export const prerender = false;

const entries = readQuestionLog();
const topQuestions = getTopQuestions(10);
const unanswered = getUnansweredQuestions(10);

const totalQuestions = entries.length;
const totalUnanswered = entries.filter((e) => !e.answered).length;

function formatDate(iso: string): string {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
  } catch {
    return iso;
  }
}
---

<AdminLayout title="Statistik">
  <h1 class="text-xl font-semibold">Statistik</h1>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    Basiert auf dem Aktivitäts-Log der Suche (logs/questions.jsonl).
  </p>

  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
      <p class="text-xs text-slate-500 dark:text-slate-400">Fragen gesamt</p>
      <p class="mt-1 text-2xl font-semibold">{totalQuestions}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
      <p class="text-xs text-slate-500 dark:text-slate-400">Nicht beantwortet</p>
      <p class="mt-1 text-2xl font-semibold text-red-600 dark:text-red-400">{totalUnanswered}</p>
    </div>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section>
      <h2 class="mb-3 text-sm font-semibold text-slate-500 dark:text-slate-400">Häufig gestellte Fragen</h2>
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-400">
            <tr>
              <th class="px-4 py-2 font-medium">Frage</th>
              <th class="px-4 py-2 font-medium text-right">Anzahl</th>
              <th class="px-4 py-2 font-medium">Zuletzt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
            {topQuestions.map((q) => (
              <tr>
                <td class="px-4 py-2">{q.question}</td>
                <td class="px-4 py-2 text-right font-medium">{q.count}</td>
                <td class="px-4 py-2 text-slate-500 dark:text-slate-400">{formatDate(q.lastAsked)}</td>
              </tr>
            ))}
            {topQuestions.length === 0 && (
              <tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">Noch keine Daten.</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="mb-3 text-sm font-semibold text-slate-500 dark:text-slate-400">Nicht beantwortete Fragen</h2>
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-400">
            <tr>
              <th class="px-4 py-2 font-medium">Frage</th>
              <th class="px-4 py-2 font-medium text-right">Anzahl</th>
              <th class="px-4 py-2 font-medium">Zuletzt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white dark:divide-slate-800 dark:bg-slate-900">
            {unanswered.map((q) => (
              <tr>
                <td class="px-4 py-2">{q.question}</td>
                <td class="px-4 py-2 text-right font-medium text-red-600 dark:text-red-400">{q.count}</td>
                <td class="px-4 py-2 text-slate-500 dark:text-slate-400">{formatDate(q.lastAsked)}</td>
              </tr>
            ))}
            {unanswered.length === 0 && (
              <tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">Bisher wurden alle Fragen beantwortet.</td></tr>
            )}
          </tbody>
        </table>
      </div>
      {unanswered.length > 0 && (
        <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
          Tipp: Für diese Fragen fehlt vermutlich passende Dokumentation — ein neues Dokument könnte helfen.
        </p>
      )}
    </section>
  </div>
</AdminLayout>
